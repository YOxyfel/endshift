{
  "name": "endshift-site",
  "version": "0.1.0",
  "private": true,
  "description": "ENDSHIFT website: static, dependency-free at runtime, built from one config file.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "node build.mjs",
    "preview": "node build.mjs --preview",
    "check": "node build.mjs --check",
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs dist 4321",
    "fonts": "node scripts/fetch-fonts.mjs",
    "og": "node scripts/og.mjs",
    "music:check": "node scripts/check-music.mjs",
    "test:functions": "node scripts/test-functions.mjs",
    "vapid": "node scripts/vapid.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "optionalDependencies": {
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0"
  }
}
